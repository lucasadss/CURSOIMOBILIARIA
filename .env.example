# Supabase — Project Settings → API no painel do projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta — nunca no cliente, nunca commitada. Só usada nas rotas de servidor
# que precisam ignorar RLS (o webhook da Payt, a checagem de acesso).
SUPABASE_SERVICE_ROLE_KEY=

# Chave de integração da Payt (Payt → Configurações/Integração). Enviada no
# corpo de todo postback como "integration_key"; o endpoint compara com esta.
PAYT_INTEGRATION_KEY=

# URL pública do site em produção (usada para montar o link do magic-link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
