# Supabase — Project Settings → API no painel do projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta — nunca no cliente, nunca commitada. Só usada nas rotas de servidor
# que precisam ignorar RLS (o webhook da Cakto, a checagem de acesso).
SUPABASE_SERVICE_ROLE_KEY=

# Mesmo valor configurado no campo "secret" do webhook no painel da Cakto.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAKTO_WEBHOOK_SECRET=

# URL pública do site em produção (usada para montar o link do magic-link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
